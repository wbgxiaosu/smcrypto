///|
test "sm4 all cross-verified vectors (ecb + cbc)" {
  for i, case in sm4_vector_cases {
    let (key_hex, pt_hex, iv_hex, ecb_hex, cbc_hex) = case
    let key = sm4_hex_bytes(key_hex)
    let pt = sm4_hex_bytes(pt_hex)
    let iv = sm4_hex_bytes(iv_hex)
    // ECB
    let ecb_ct = @sm4.encrypt_ecb(key, pt).unwrap()
    assert_eq(sm4_bytes_hex(ecb_ct), ecb_hex, msg="ecb #\{i}")
    assert_eq(
      sm4_bytes_hex(@sm4.decrypt_ecb(key, ecb_ct).unwrap()),
      pt_hex,
      msg="ecb roundtrip #\{i}",
    )
    // CBC
    let cbc_ct = @sm4.encrypt_cbc(key, iv, pt).unwrap()
    assert_eq(sm4_bytes_hex(cbc_ct), cbc_hex, msg="cbc #\{i}")
    assert_eq(
      sm4_bytes_hex(@sm4.decrypt_cbc(key, iv, cbc_ct).unwrap()),
      pt_hex,
      msg="cbc roundtrip #\{i}",
    )
  }
}
