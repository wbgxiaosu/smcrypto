///|
fn sm3_hex_bytes(s : String) -> Bytes {
  @hexutil.decode(s).unwrap()
}

///|
test "sm3 all cross-verified vectors (one-shot)" {
  for i, case in sm3_msg_vectors {
    let (msg_hex, want) = case
    let got = @sm3.hex_digest(sm3_hex_bytes(msg_hex))
    assert_eq(got, want, msg="vector #\{i} mismatch")
  }
}

///|
test "sm3 streaming update equals one-shot" {
  for i, case in sm3_msg_vectors {
    let (msg_hex, want) = case
    let data = sm3_hex_bytes(msg_hex)
    // 按与向量序号相关的位置切分，模拟真实流式输入
    let cut = if data.length() == 0 { 0 } else { i % (data.length() + 1) }
    let h = @sm3.Sm3::new()
    h.update(data[0:cut].to_owned())
    h.update(data[cut:data.length()].to_owned())
    assert_eq(
      @hexutil.encode(h.finalize()),
      want,
      msg="streaming #\{i} mismatch",
    )
  }
}

///|
test "sm3 many small updates equals one-shot" {
  for i, case in sm3_msg_vectors {
    let (msg_hex, want) = case
    let data = sm3_hex_bytes(msg_hex)
    let h = @sm3.Sm3::new()
    for j in 0..<data.length() {
      h.update(data[j:j + 1].to_owned())
    }
    assert_eq(
      @hexutil.encode(h.finalize()),
      want,
      msg="byte-wise #\{i} mismatch",
    )
  }
}

///|
test "sm3 reset reuses hasher correctly" {
  for i, case in sm3_msg_vectors {
    let (msg_hex, want) = case
    let h = @sm3.Sm3::new()
    h.update(sm3_hex_bytes("deadbeef"))
    h.reset()
    h.update(sm3_hex_bytes(msg_hex))
    assert_eq(@hexutil.encode(h.finalize()), want, msg="reset #\{i} mismatch")
  }
}
